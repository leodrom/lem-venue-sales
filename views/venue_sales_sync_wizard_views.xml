<odoo>
    <record id="view_venue_sales_sync_wizard_form" model="ir.ui.view">
        <field name="name">venue.sales.sync.wizard.form</field>
        <field name="model">venue.sales.sync.wizard</field>
        <field name="arch" type="xml">
            <form string="Завантажити дані">
                <div class="alert alert-info" role="alert">
                    Система підключиться до сервера й завантажить дані каси за обраний період.
                    Зміни, що вже є в базі, буде оновлено; нові — додано.
                </div>
                <group>
                    <field name="location_id" readonly="1"/>
                    <field name="date_from"/>
                    <field name="date_to"/>
                </group>
                <footer>
                    <button string="Завантажити" type="object" name="action_sync" class="btn-primary"/>
                    <button string="Скасувати" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>

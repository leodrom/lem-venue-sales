<odoo>
    <record id="view_venue_sales_location_list" model="ir.ui.view">
        <field name="name">venue.sales.location.list</field>
        <field name="model">venue.sales.location</field>
        <field name="arch" type="xml">
            <list>
                <field name="avatar_128" widget="image" options="{'size': [24, 24]}" string=""/>
                <field name="name"/>
                <field name="connection_id"/>
                <field name="provider"/>
                <field name="external_id"/>
                <field name="session_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_venue_sales_location_form" model="ir.ui.view">
        <field name="name">venue.sales.location.form</field>
        <field name="model">venue.sales.location</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_open_sync_wizard" type="object"
                            string="Завантажити дані" class="btn-primary" icon="fa-cloud-download"/>
                </header>
                <sheet>
                    <div class="oe_avatar" style="float: left; margin-right: 16px;">
                        <field name="image_1920" widget="contact_image" class="oe_avatar"
                               options="{'preview_image': 'avatar_128', 'size': [90, 90]}"/>
                        <field name="avatar_128" invisible="1"/>
                    </div>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(action_venue_sales_session)d" type="action"
                                class="oe_stat_button" icon="fa-money">
                            <field name="session_count" widget="statinfo" string="Зміни"/>
                        </button>
                    </div>
                    <group>
                        <field name="name"/>
                        <field name="connection_id"/>
                        <field name="external_id"/>
                        <field name="active"/>
                    </group>
                    <group string="Автозавантаження">
                        <field name="auto_sync_hour" placeholder="Вимкнено"/>
                        <field name="last_auto_sync_date"/>
                    </group>
                    <notebook>
                        <page string="Каси">
                            <field name="register_ids">
                                <list editable="bottom">
                                    <field name="name" width="150px"/>
                                    <field name="is_fiscal" width="130px"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_venue_sales_location_search" model="ir.ui.view">
        <field name="name">venue.sales.location.search</field>
        <field name="model">venue.sales.location</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="connection_id"/>
                <field name="external_id"/>
                <filter string="Архівовані" name="inactive" domain="[('active', '=', False)]"/>
                <group>
                    <filter string="Підключення" name="groupby_connection" context="{'group_by': 'connection_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_venue_sales_location" model="ir.actions.act_window">
        <field name="name">Заклади</field>
        <field name="res_model">venue.sales.location</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_venue_sales_location_search"/>
        <field name="path">lem-venue-sales-locations</field>
    </record>
</odoo>
